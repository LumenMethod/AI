# Telegram
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-xxxxxxxx
CHANNEL_ID=@human2035channel

# Anthropic Claude API
# Получить на: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Admins (через запятую, Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Database (по умолчанию SQLite, для продакшна используй PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/human2035
DATABASE_URL=sqlite+aiosqlite:///./human2035.db

# Notion — база знаний
# Получить: notion.so/my-integrations → New integration → Internal Token
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chroma — папка для хранения векторной БД (локально)
CHROMA_PERSIST_DIR=./chroma_db

# Meta (Instagram + Facebook)
# Получить: developers.facebook.com → My Apps → Graph API Explorer
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# OpenAI (DALL-E 3 — генерация изображений для постов)
# Получить: platform.openai.com → API Keys
OPENAI_API_KEY=

# X (Twitter)
# Получить: developer.twitter.com → Projects & Apps → твой App → Keys and Tokens
# Нужен уровень доступа: Read and Write + Basic
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# TikTok
# Получить: developers.tiktok.com → Manage Apps → Content Posting API (продакшн доступ)
TIKTOK_ACCESS_TOKEN=

# Папка кеша сгенерированных изображений
IMAGE_CACHE_DIR=./image_cache

# Telegram — тематические ветки (оставь пустым если канал ещё не создан)
CHANNEL_HEALTH=@human2035_health
CHANNEL_FINANCE=@human2035_finance
CHANNEL_TECH=@human2035_tech
CHANNEL_NEWS=@human2035_news
CHANNEL_EDU=@human2035_edu

# Мультиязычность — языки по веткам (JSON)
# Ключи: health, finance, tech, news, edu, main
# Значения: списки кодов языков: ru, en, uk, pl, de, es, fr, tr, ar, zh
BRANCH_LANGUAGES={"health":["en","pl","uk"],"finance":["ru","en"],"tech":["ru","en"],"news":["ru"],"edu":["ru","en"],"main":["ru"]}

# Каналы по веткам и языкам (JSON)
# Формат: {"ветка": {"язык": "@username_канала"}}
BRANCH_CHANNELS={"health":{"ru":"@human2035_health","en":"@human2035_health_en","pl":"@human2035_health_pl","uk":"@human2035_health_uk"},"finance":{"ru":"@human2035_finance","en":"@human2035_finance_en"},"tech":{"ru":"@human2035_tech","en":"@human2035_tech_en"},"news":{"ru":"@human2035_news"},"edu":{"ru":"@human2035_edu","en":"@human2035_edu_en"}}
